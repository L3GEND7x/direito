# ======================================================================
# JurisData — variáveis de ambiente
# Copie para .env (NUNCA versione o .env) e preencha.
# Em nuvem, prefira o cofre de segredos do provedor a um arquivo .env.
# ======================================================================

# producao | desenvolvimento
JURISDATA_AMBIENTE=producao

# Gere as duas chaves com:  python -m app.cli gerar-chaves
# A DATA_KEY criptografa CPFs, resultados e segredos de MFA. Guarde cópia em cofre:
# se ela for perdida, os dados criptografados não podem ser recuperados.
JURISDATA_SECRET_KEY=
JURISDATA_DATA_KEY=

# Senha do PostgreSQL usada pelo docker-compose
POSTGRES_PASSWORD=

# 1 = cookie só via HTTPS (obrigatório em produção). Use 0 apenas em teste local sem HTTPS.
JURISDATA_COOKIE_SECURE=1
# IP do proxy reverso (para registrar o IP real do usuário na auditoria)
FORWARDED_ALLOW_IPS=127.0.0.1

# Regras de uso
JURISDATA_RETENCAO_DIAS=365
JURISDATA_LIMITE_DIARIO_CONSULTAS=30
JURISDATA_ASSISTENTE_EXIGE_APROVACAO=1
JURISDATA_SESSAO_INATIVIDADE_MIN=30
JURISDATA_SESSAO_MAXIMA_HORAS=12
JURISDATA_TENTATIVAS_LOGIN_MAX=5
JURISDATA_BLOQUEIO_LOGIN_MIN=15

# Conector simulado (dados fictícios). Proibido em produção.
JURISDATA_MODO_SIMULADO=0

# ----------------------------------------------------------------------
# SERPRO — preencher SOMENTE após contratar, copiando os valores da
# documentação do contrato no API Center (apicenter.estaleiro.serpro.gov.br).
# ----------------------------------------------------------------------
JURISDATA_SERPRO_CONSUMER_KEY=
JURISDATA_SERPRO_CONSUMER_SECRET=
# URL do endpoint de token OAuth2 (client_credentials) informada no contrato
JURISDATA_SERPRO_TOKEN_URL=
# CNPJ: URL base da versão contratada; o sistema acrescenta /basica|qsa|empresa/{cnpj}
JURISDATA_SERPRO_CNPJ_URL=
# CPF v3: modelo de URL com os marcadores {cpf} e {nascimento_ddmmaaaa} ou {nascimento_iso}.
# O aviso oficial da v3 cita o endpoint https://apicpf.estaleiro.serpro.gov.br/api/v3/cpf/
# A forma de envio da data de nascimento deve ser CONFERIDA na documentação antes de preencher.
# Atenção: segundo o mesmo aviso, a v3 não tem ambiente de testes — toda chamada é cobrada.
JURISDATA_SERPRO_CPF_URL_TEMPLATE=
JURISDATA_SERPRO_TIMEOUT_S=20

# BrasilAPI (dados públicos de CNPJ, não oficial em tempo real)
JURISDATA_BRASILAPI_HABILITADA=0
