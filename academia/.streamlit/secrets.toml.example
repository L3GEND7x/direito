# Modelo. NÃO coloque o arquivo real no GitHub (secrets.toml já está no .gitignore).
# No Streamlit Community Cloud: app → Settings → Secrets → cole o conteúdo abaixo com os valores do seu projeto.
# No computador: copie para academia/.streamlit/secrets.toml.
#
# Supabase → Project Settings → API Keys / Data API:
#   url      = "Project URL"
#   anon_key = a chave PÚBLICA: "anon public" (formato eyJ...) ou "publishable" (formato sb_publishable_...).
#   site_url = o link público do app (para onde volta o link de "Esqueci a senha").
# Nunca use a "service_role" nem uma "secret" (sb_secret_...): elas ignoram o Row Level Security.
# O app se recusa a abrir se receber uma chave secreta.

[supabase]
url = "https://SEU-PROJETO.supabase.co"
anon_key = "COLE-AQUI-A-CHAVE-PUBLICA"
site_url = "https://SEU-APP.streamlit.app"

# Personal IA (opcional). Chave da API da Anthropic: https://console.anthropic.com → API Keys.
# Sem esta seção a aba Personal IA avisa que não está configurada. Os demais campos estão no README.
[ia]
anthropic_api_key = "COLE-AQUI-A-CHAVE-DA-ANTHROPIC"
